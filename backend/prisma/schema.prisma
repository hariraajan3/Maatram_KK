// Maatram KK Database Schema
// Prisma Schema for Neon PostgreSQL (Serverless)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum UserRole {
  admin
  tutorLead
  tutor
  coordinator
}

enum TutorStatus {
  active
  inactive
  suspended
}

enum StudentPhase {
  Selection
  Scheduling
  Attendance
  Completed
}

enum ClassStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum ClassModality {
  virtual
  in_person
  hybrid
}

enum OnboardingStatus {
  pending
  approved
  rejected
  completed
}

enum SwapRequestStatus {
  pending
  approved
  rejected
  completed
}

enum Medium {
  Tamil
  English
}

enum District {
  Chennai
  Coimbatore
  Other
}

enum Subject {
  Physics
  Maths
  Chemistry
  Commerce
  Economics
  Accounts
  Tamil
  English
}

enum SelectionPhase {
  Phase1_Selection
  Phase2_Televerification
  Phase3_PanelInterview
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PHASE_UPDATE
  ATTENDANCE_MARK
  TUTOR_ASSIGN
}

// ============================================
// MODELS
// ============================================

// User - Authentication and Role Management
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  avatar       String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  tutor              Tutor?
  createdClasses     Class[]              @relation("CreatedBy")
  createdOnboarding  OnboardingRequest[]  @relation("RequestedBy")
  recordedAttendance Attendance[]         @relation("RecordedBy")
  archivedRecords    ArchivedRecord[]     @relation("ArchivedBy")
  createdApplications StudentApplication[] @relation("ApplicationCreatedBy")
  phase1Reviews      StudentApplication[] @relation("Phase1Reviewer")
  phase2Reviews      StudentApplication[] @relation("Phase2Reviewer")
  phase3Reviews      StudentApplication[] @relation("Phase3Reviewer")
  auditLogs          AuditLog[]           @relation("AuditUser")

  @@index([email])
  @@index([role])
  @@map("users")
}

// Tutor - Tutor Profile linked to User
model Tutor {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @unique @map("user_id") @db.Uuid
  name           String      @db.VarChar(255)
  email          String      @unique @db.VarChar(255)
  phoneEncrypted String?     @map("phone_encrypted") @db.Text
  status         TutorStatus @default(active)
  medium         Medium?     // Medium the tutor teaches (Tamil/English)
  district       District?   // District the tutor serves
  subjects       Json        @default("[]") // Array of Subject enums: ["Physics", "Maths"]
  avgAttendance  Decimal?    @map("avg_attendance") @default(0) @db.Decimal(5, 2)
  maxStudents    Int         @default(20) @map("max_students") // Maximum students this tutor can handle
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes            Class[]
  proposedSwaps      SwapRequest[]           @relation("ProposedBy")
  targetSwaps        SwapRequest[]           @relation("TargetTutor")
  studentAssignments StudentTutorAssignment[]

  @@index([userId])
  @@index([email])
  @@index([medium])
  @@index([district])
  @@index([status])
  @@map("tutors")
}

// Student - Selected students in the program
model Student {
  id                       String       @id @default(uuid()) @db.Uuid
  name                     String       @db.VarChar(255)
  phase                    StudentPhase @default(Selection)
  medium                   Medium?      // Tamil medium or English
  district                 District?    // Chennai, Coimbatore, or Other
  requestedSubjects        Json         @default("[]") @map("requested_subjects") // Array of Subject enums
  guardianContactEncrypted String?      @map("guardian_contact_encrypted") @db.Text
  group                    String?      @db.VarChar(100) // Student group identifier
  progressScore            Int          @default(0) @map("progress_score")
  isActive                 Boolean      @default(true) @map("is_active")
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  attendance         Attendance[]
  application        StudentApplication?
  tutorAssignments   StudentTutorAssignment[]

  @@index([group])
  @@index([phase])
  @@index([medium])
  @@index([district])
  @@index([isActive])
  @@map("students")
}

// StudentTutorAssignment - Links students to tutors by subject
model StudentTutorAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  tutorId    String   @map("tutor_id") @db.Uuid
  subject    Subject  // The subject for this assignment
  isActive   Boolean  @default(true) @map("is_active")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([studentId, tutorId, subject])
  @@index([studentId])
  @@index([tutorId])
  @@index([subject])
  @@map("student_tutor_assignments")
}

// Class - Scheduled classes/sessions
model Class {
  id           String        @id @default(uuid()) @db.Uuid
  phase        StudentPhase
  tutorId      String?       @map("tutor_id") @db.Uuid
  subject      Subject       // Subject for this class
  studentGroup String        @map("student_group") @db.VarChar(100)
  startTime    DateTime      @map("start_time") @db.Timestamptz(6)
  endTime      DateTime      @map("end_time") @db.Timestamptz(6)
  status       ClassStatus   @default(scheduled)
  modality     ClassModality
  meetingLink  String?       @map("meeting_link") @db.Text
  notes        String?       @db.Text
  createdBy    String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  tutor        Tutor?        @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  creator      User?         @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  sessions     Session[]
  swapRequests SwapRequest[]
  attendance   Attendance[]

  @@index([tutorId])
  @@index([studentGroup])
  @@index([startTime])
  @@index([subject])
  @@index([status])
  @@map("classes")
}

// Session - Individual class sessions
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  startTime DateTime  @map("start_time") @db.Timestamptz(6)
  endTime   DateTime? @map("end_time") @db.Timestamptz(6)
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@map("sessions")
}

// OnboardingRequest - New tutor/staff onboarding
model OnboardingRequest {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(255)
  email          String           @db.VarChar(255)
  phoneEncrypted String?          @map("phone_encrypted") @db.Text
  documents      Json             @default("[]")
  status         OnboardingStatus @default(pending)
  requestedBy    String?          @map("requested_by") @db.Uuid
  reviewNotes    String?          @map("review_notes") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  requester User? @relation("RequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@map("onboarding_requests")
}

// SwapRequest - Class swap requests between tutors
model SwapRequest {
  id                String            @id @default(uuid()) @db.Uuid
  classId           String            @map("class_id") @db.Uuid
  reason            String?           @db.Text
  proposedByTutorId String            @map("proposed_by_tutor_id") @db.Uuid
  targetTutorId     String?           @map("target_tutor_id") @db.Uuid
  desiredDate       DateTime?         @map("desired_date") @db.Timestamptz(6)
  status            SwapRequestStatus @default(pending)
  reviewNotes       String?           @map("review_notes") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  class           Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  proposedByTutor Tutor @relation("ProposedBy", fields: [proposedByTutorId], references: [id], onDelete: Cascade)
  targetTutor     Tutor? @relation("TargetTutor", fields: [targetTutorId], references: [id], onDelete: SetNull)

  @@index([classId])
  @@index([status])
  @@index([proposedByTutorId])
  @@map("swap_requests")
}

// Attendance - Student attendance records
model Attendance {
  id           String   @id @default(uuid()) @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  present      Boolean  @default(false)
  absentReason String?  @map("absent_reason") @db.Text // Reason if absent
  marks        Decimal? @db.Decimal(5, 2) // Optional marks (0-100)
  notes        String?  @db.Text
  recordedBy   String?  @map("recorded_by") @db.Uuid
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recorder User?   @relation("RecordedBy", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@unique([classId, studentId, date])
  @@index([classId])
  @@index([studentId])
  @@index([date])
  @@index([present])
  @@map("attendance")
}

// StudentApplication - Student selection process
model StudentApplication {
  id                          String         @id @default(uuid()) @db.Uuid
  name                        String         @db.VarChar(255)
  email                       String?        @db.VarChar(255)
  phoneEncrypted              String?        @map("phone_encrypted") @db.Text
  guardianContactEncrypted    String?        @map("guardian_contact_encrypted") @db.Text
  medium                      Medium?        // Tamil medium or English
  district                    District?      // Chennai, Coimbatore, or Other
  requestedSubjects           Json           @default("[]") @map("requested_subjects") // Array of Subject enums
  phase                       SelectionPhase @default(Phase1_Selection)
  
  // Phase 1 - Initial Selection
  phase1Notes                 String?        @map("phase1_notes") @db.Text
  phase1ReviewedBy            String?        @map("phase1_reviewed_by") @db.Uuid
  phase1ReviewedAt            DateTime?      @map("phase1_reviewed_at") @db.Timestamptz(6)
  
  // Phase 2 - Tele-verification
  isTeleSelected              Boolean        @default(false) @map("is_tele_selected")
  phase2TeleverificationNotes String?        @map("phase2_televerification_notes") @db.Text
  phase2ReviewedBy            String?        @map("phase2_reviewed_by") @db.Uuid
  phase2ReviewedAt            DateTime?      @map("phase2_reviewed_at") @db.Timestamptz(6)
  
  // Phase 3 - Panel Interview
  isPanelDone                 Boolean        @default(false) @map("is_panel_done")
  phase3PanelInterviewNotes   String?        @map("phase3_panel_interview_notes") @db.Text
  phase3ReviewedBy            String?        @map("phase3_reviewed_by") @db.Uuid
  phase3ReviewedAt            DateTime?      @map("phase3_reviewed_at") @db.Timestamptz(6)
  
  // Final Selection
  studentId                   String?        @unique @map("student_id") @db.Uuid // Created when selected
  rejectionReason             String?        @map("rejection_reason") @db.Text
  
  createdBy                   String?        @map("created_by") @db.Uuid
  createdAt                   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  student        Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  creator        User?    @relation("ApplicationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  phase1Reviewer User?    @relation("Phase1Reviewer", fields: [phase1ReviewedBy], references: [id], onDelete: SetNull)
  phase2Reviewer User?    @relation("Phase2Reviewer", fields: [phase2ReviewedBy], references: [id], onDelete: SetNull)
  phase3Reviewer User?    @relation("Phase3Reviewer", fields: [phase3ReviewedBy], references: [id], onDelete: SetNull)

  @@index([phase])
  @@index([medium])
  @@index([district])
  @@index([email])
  @@index([isTeleSelected])
  @@index([isPanelDone])
  @@map("student_applications")
}

// AuditLog - Admin action logs
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  action      AuditAction
  entityType  String      @map("entity_type") @db.VarChar(100) // e.g., "StudentApplication", "Attendance"
  entityId    String?     @map("entity_id") @db.Uuid
  oldData     Json?       @map("old_data")
  newData     Json?       @map("new_data")
  description String?     @db.Text
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ArchivedRecord - Archived/deleted data for compliance
model ArchivedRecord {
  id         String   @id @default(uuid()) @db.Uuid
  recordType String   @map("record_type") @db.VarChar(100)
  recordData Json     @map("record_data")
  archivedAt DateTime @default(now()) @map("archived_at") @db.Timestamptz(6)
  archivedBy String?  @map("archived_by") @db.Uuid

  // Relations
  archiver User? @relation("ArchivedBy", fields: [archivedBy], references: [id], onDelete: SetNull)

  @@index([recordType])
  @@index([archivedAt])
  @@map("archived_records")
}
