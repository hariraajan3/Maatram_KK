// Maatram KK Database Schema
// Prisma Schema for Neon PostgreSQL (Serverless)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUM

enum Role {
  ADMIN
  TUTOR_LEADS
  SELECTION_TEAM
  TUTOR
  ATTENDANCE_TRACKING_TEAM
  CLASS_INSPECTION_TEAM
}

enum ScheduleStatus {
  SCHEDULED
  INPROGRESS
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum StudentPhase {
  Selection
  Scheduling
  Attendance
  COMPLETED
}

enum OnboardingStatus {
  pending
  approved
  rejected
  completed
}

enum Medium {
  Tamil
  English
}

enum District {
  Chennai
  Coimbatore
  Other
}

enum Subject {
  Physics
  Maths
  Chemistry
  Commerce
  Economics
  Accounts
  Tamil
  English
}

enum SelectionPhase {
  Phase1_Selection
  Phase2_Televerification
  Phase3_PanelInterview
}

// User - Authentication and Role Management

model User {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  password               String
  name                   String
  role                   Role
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  admin                  Admin?
  tutorLead              TutorLead?
  tutor                  Tutor?
  selectionTeam          SelectionTeam?
  attendanceTrackingTeam AttendanceTrackingTeam?
  classInspectionTeam    ClassInspectionTeam?

  // Student Application Relations
  createdApplications StudentApplication[] @relation("CreatedApplications")
  phase1Applications  StudentApplication[] @relation("Phase1Reviewer")
  phase2Applications  StudentApplication[] @relation("Phase2Reviewer")
  phase3Applications  StudentApplication[] @relation("Phase3Reviewer")
  auditLogs           AuditLog[]

  @@map("user")
}

model Admin {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  phoneNumber  String?
  companyOrOrg String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("admin")
}

model TutorLead {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("tutor_leads")
}

model Tutor {
  id                      Int              @id @default(autoincrement())
  kkId                    String           @unique
  userId                  Int              @unique
  tutoringSubjects        Subject
  tutoringDistrict        District
  tutoringMedium          Medium
  tutorAddress            String
  phoneNumber             String
  collegeOrCompany        String
  alumniOrYearStudying    String
  tutoringExperienceYears Int
  onboardingStatus        OnboardingStatus @default(pending)
  createdAt               DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  schedules   Schedule[]
  attendances StudentAttendance[]

  @@map("tutor")
}

model SelectionTeam {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("selection_team")
}

model AttendanceTrackingTeam {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("attendance_tracking_team")
}

model ClassInspectionTeam {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("class_inspection_team")
}

model Student {
  id                 Int      @id @default(autoincrement())
  kkId               String   @unique
  name               String
  schoolName         String?
  district           String?
  email              String?
  yearOfStudying     String   @default("12th")
  tutoringSubjects   Json
  address            String?
  class11PublicMarks Json
  subjectMarks       Json
  parentName         String?
  phoneNumber        String?
  createdAt          DateTime @default(now())

  attendances       StudentAttendance[]
  overallAttendance OverallAttendance[]
  application       StudentApplication?

  @@map("student")
}

model Schedule {
  id           Int            @id @default(autoincrement())
  scheduleDate DateTime
  scheduleAt   DateTime
  subject      Subject
  medium       Medium
  district     District
  tutorId      Int
  meetLink     String?
  status       ScheduleStatus @default(SCHEDULED)
  createdAt    DateTime       @default(now())

  tutor Tutor @relation(fields: [tutorId], references: [id])

  attendances   StudentAttendance[]
  swapRequests  ClassSwapRequest[]
  reschedules   ReschedulingRequest[]
  cancellations ClassCancellation[]

  @@map("scheduling")
}

model StudentAttendance {
  id               Int               @id @default(autoincrement())
  schedulingId     Int
  classDate        DateTime
  tutorId          Int
  studentId        Int
  attendanceMarked Boolean           @default(false)
  attendanceStatus AttendanceStatus?
  remarks          String?
  totalStudents    Int?

  schedule Schedule @relation(fields: [schedulingId], references: [id])
  tutor    Tutor    @relation(fields: [tutorId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([schedulingId, studentId])
  @@map("student_attendance")
}

model OverallAttendance {
  id                   Int     @id @default(autoincrement())
  studentId            Int
  subject              String
  totalClasses         Int
  classesAttended      Int
  attendancePercentage Decimal @db.Decimal(5, 2)

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, subject])
  @@map("overall_attendance")
}

model ClassSwapRequest {
  id                 Int           @id @default(autoincrement())
  schedulingId       Int
  requestedByTutorId Int
  requestedToTutorId Int
  reason             String?
  status             RequestStatus @default(PENDING)
  createdAt          DateTime      @default(now())

  schedule Schedule @relation(fields: [schedulingId], references: [id])

  @@map("class_swap_requests")
}

model ReschedulingRequest {
  id            Int           @id @default(autoincrement())
  schedulingId  Int
  requestedDate DateTime
  requestedTime String
  reason        String?
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  schedule Schedule @relation(fields: [schedulingId], references: [id])

  @@map("rescheduling_requests")
}

model ClassCancellation {
  id           Int           @id @default(autoincrement())
  schedulingId Int
  reason       String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  schedule Schedule @relation(fields: [schedulingId], references: [id])

  @@map("class_cancellations")
}

model TutorOnboarding {
  id               Int              @id @default(autoincrement())
  fullName         String
  email            String           @unique
  phoneNumber      String?
  medium           Medium
  district         District
  subject          Subject
  onboardingStatus OnboardingStatus @default(pending)
  invitedOn        DateTime         @default(now())
  acceptedOn       DateTime?

  @@map("tutor_invitations")
}

model StudentApplication {
  id                       Int     @id @default(autoincrement())
  name                     String
  email                    String?
  phoneEncrypted           String?
  guardianContactEncrypted String?
  medium                   Medium?
  district                 String?
  requestedSubjects        Json
  phase                    String  @default("Phase1_Selection")

  createdBy Int
  creator   User @relation("CreatedApplications", fields: [createdBy], references: [id])

  phase1Notes      String?
  phase1ReviewedBy Int?
  phase1Reviewer   User?     @relation("Phase1Reviewer", fields: [phase1ReviewedBy], references: [id])
  phase1ReviewedAt DateTime?

  phase2TeleverificationNotes String?
  phase2ReviewedBy            Int?
  phase2Reviewer              User?     @relation("Phase2Reviewer", fields: [phase2ReviewedBy], references: [id])
  phase2ReviewedAt            DateTime?

  phase3PanelInterviewNotes String?
  phase3ReviewedBy          Int?
  phase3Reviewer            User?     @relation("Phase3Reviewer", fields: [phase3ReviewedBy], references: [id])
  phase3ReviewedAt          DateTime?

  studentId Int?     @unique
  student   Student? @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())

  @@map("student_applications")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String?
  entityId    String?
  description String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}
