// Maatram KK Database Schema
// Prisma Schema for Neon PostgreSQL (Serverless)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUM

enum Role {
  ADMIN
  TUTOR_LEAD
  SELECTION_TEAM
  TUTOR
  ATTENDANCE_TRACKING_TEAM
  CLASS_INSPECTION_TEAM
}

enum ScheduleStatus {
  SCHEDULED
  INPROGRESS
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum StudentPhase {
  Selection
  Scheduling
  Attendance
  COMPLETED
}

enum OnboardingStatus {
  pending
  approved
  rejected
  completed
}

enum Medium {
  Tamil
  English
}

enum District {
  Chennai
  Coimbatore
  Other
}

enum Subject {
  Physics
  Maths
  Chemistry
  Commerce
  Economics
  Accounts
  Tamil
  English
}

enum SelectionPhase {
  TELE_VERIFICATION
  PANEL_INTERVIEW
  FINAL_SELECTION
}

enum SelectionStatus {
  PENDING
  SELECTED
  REJECTED
}

// User - Authentication and Role Management

model User {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  password               String
  name                   String
  role                   Role
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  admin                  Admin?
  tutorLead              TutorLead?
  tutor                  Tutor?
  selectionTeam          SelectionTeam?
  attendanceTrackingTeam AttendanceTrackingTeam?
  classInspectionTeam    ClassInspectionTeam?

  @@map("user")
}

model Admin {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  phoneNumber  String?
  companyOrOrg String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("admin")
}

model TutorLead {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("tutor_lead")
}

model Tutor {
  id                      Int              @id @default(autoincrement())
  kkId                    String           @unique
  userId                  Int              @unique
  tutoringSubjects        Subject
  tutoringDistrict        District
  tutoringMedium          Medium
  tutorAddress            String
  phoneNumber             String
  collegeOrCompany        String
  alumniOrYearStudying    String
  tutoringExperienceYears Int
  onboardingStatus        OnboardingStatus @default(pending)
  meetLink                String?
  createdAt               DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  schedules   Schedule[]
  attendances StudentAttendance[]

  @@map("tutor")
}

model SelectionTeam {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("selection_team")
}

model AttendanceTrackingTeam {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("attendance_tracking_team")
}

model ClassInspectionTeam {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  phoneNumber            String?
  collegeOrCompany       String?
  yearOfStudyingOrAlumni String?
  createdAt              DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("class_inspection_team")
}

model Student {
  id                 Int          @id @default(autoincrement())
  kkId               String       @unique
  name               String
  schoolName         String?
  district           String?
  email              String?
  yearOfStudying     String       @default("12th")
  tutoringSubjects   Json
  address            String?
  class11PublicMarks Int?
  subjectMarks       Json
  parentName         String?
  medium             Medium?
  phoneNumber        String?
  phase              StudentPhase @default(Selection)
  createdAt          DateTime     @default(now())

  application StudentApplication?

  @@map("student")
}

model Schedule {
  id           Int            @id @default(autoincrement())
  classId      String?
  scheduleDate DateTime
  scheduleAt   DateTime
  subject      Subject
  medium       Medium
  district     District
  tutorId      Int
  meetLink     String?
  status       ScheduleStatus @default(SCHEDULED)
  createdAt    DateTime       @default(now())

  tutor Tutor @relation(fields: [tutorId], references: [id])

  attendances   StudentAttendance[]
  swapRequests  ClassSwapRequest[]
  reschedules   ReschedulingRequest[]
  cancellations ClassCancellation[]

  @@map("scheduling")
}

model StudentAttendance {
  id               Int               @id @default(autoincrement())
  schedulingId     Int
  classDate        DateTime
  tutorId          Int
  studentId        Int
  attendanceMarked Boolean           @default(false)
  attendanceStatus AttendanceStatus?
  remarks          String?
  totalStudents    Int?

  schedule Schedule @relation(fields: [schedulingId], references: [id])
  tutor    Tutor    @relation(fields: [tutorId], references: [id])

  @@unique([schedulingId, studentId])
  @@map("student_attendance")
}

model OverallAttendance {
  id                   Int     @id @default(autoincrement())
  studentId            Int
  subject              String
  totalClasses         Int
  classesAttended      Int
  attendancePercentage Decimal @db.Decimal(5, 2)

  @@unique([studentId, subject])
  @@map("overall_attendance")
}

model ClassSwapRequest {
  id                 Int           @id @default(autoincrement())
  schedulingId       Int
  requestedByTutorId Int
  requestedToTutorId Int
  reason             String?
  status             RequestStatus @default(PENDING)
  createdAt          DateTime      @default(now())

  schedule Schedule @relation(fields: [schedulingId], references: [id])

  @@map("class_swap_requests")
}

model ReschedulingRequest {
  id            Int           @id @default(autoincrement())
  schedulingId  Int
  requestedDate DateTime
  requestedTime String
  reason        String?
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  schedule Schedule @relation(fields: [schedulingId], references: [id])

  @@map("rescheduling_requests")
}

model ClassCancellation {
  id           Int           @id @default(autoincrement())
  schedulingId Int
  reason       String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  schedule Schedule @relation(fields: [schedulingId], references: [id])

  @@map("class_cancellations")
}

model OnboardingUsers {
  id               Int              @id @default(autoincrement())
  fullName         String
  email            String           @unique
  role             Role
  medium           Medium?
  district         District?
  subject          Subject?
  onboardingStatus OnboardingStatus @default(pending)
  invitedOn        DateTime         @default(now())
  acceptedOn       DateTime?

  @@map("Onboarding_Users")
}

model StudentApplication {
  id        Int     @id @default(autoincrement())
  studentId Int     @unique
  student   Student @relation(fields: [studentId], references: [id])

  currentPhase SelectionPhase @default(TELE_VERIFICATION)

  teleStatus  SelectionStatus @default(PENDING)
  panelStatus SelectionStatus @default(PENDING)

  phase1Notes String? @map("phase1_notes") // Tele-verification notes
  phase2Notes String? @map("phase2_notes") // Panel Interview notes

  assignedTutorId Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("student_application")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entityType  String?
  entityId    String?
  description String?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}
